spring.application.name=ms-bff-privado
server.port=8082

# Microservicio de eventos
ms.eventos.url=http://localhost:8081

# Validación JWT contra Azure AD
spring.security.oauth2.resourceserver.jwt.issuer-uri=TU_TENANT_ID
spring.security.oauth2.resourceserver.jwt.audiences=TU_APPLICATION_CLIENT_ID

# Seguridad
logging.level.org.springframework.security=DEBUG